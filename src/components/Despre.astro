---
import { Image } from 'astro:assets';
import despreImage from '../assets/images/adrian-despre.webp';
---

<section id="despre" data-screen-label="Despre mine" class="despre">
  <div class="despre__image-frame">
    <Image
      src={despreImage}
      alt="Olari Adrian Ionuț alături de echipa de execuție pe șantier"
      widths={[400, 700]}
      sizes="(max-width: 1059px) 100vw, 460px"
      loading="lazy"
      class="despre__image"
    />
  </div>
  <div>
    <p class="section-eyebrow">07 — DESPRE MINE</p>
    <h2 class="despre__title">Olari Adrian Ionuț</h2>
    <p class="despre__subtitle">Diriginte de șantier · RTE · Consultant tehnic</p>
    <p class="despre__text">
      Sunt specialist autorizat de <strong>Inspectoratul de Stat în Construcții</strong> și ofer servicii de
      dirigenție de șantier, responsabil tehnic cu execuția și consultanță tehnică în municipiul și județul Iași.
      Abordarea mea se bazează pe implicare, comunicare directă și urmărirea atentă a cerințelor tehnice aferente
      fiecărui proiect.
    </p>
    <blockquote class="despre__quote">
      „Rolul meu este să urmăresc ca lucrările să fie executate în concordanță cu proiectul, cerințele tehnice și
      obligațiile asumate de participanții implicați."
    </blockquote>
  </div>
</section>

<style>
  .despre {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: start;
    padding-bottom: var(--section-gap);
  }

  @media (max-width: 1059px) {
    .despre {
      grid-template-columns: 1fr;
    }
  }

  .despre__image-frame {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-navy);
    box-shadow: var(--shadow-despre-image);
  }

  .despre__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .despre__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(28px, 3.4vw, 40px);
    letter-spacing: -0.015em;
    margin: 0 0 6px;
    color: var(--color-navy);
  }

  .despre__subtitle {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-muted);
    margin: 0 0 24px;
  }

  .despre__text {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-anthracite);
    margin: 0 0 24px;
  }

  .despre__text strong {
    color: var(--color-navy);
  }

  .despre__quote {
    margin: 0;
    padding: 24px 26px;
    background: #fff;
    border-left: 4px solid var(--color-accent-solid);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
    font-family: var(--font-heading);
    font-size: 19px;
    line-height: 1.5;
    color: var(--color-navy);
    font-weight: 500;
  }
</style>
