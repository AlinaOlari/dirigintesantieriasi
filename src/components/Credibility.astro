---
import { credibilityItems } from '../data/credibility';

const items = credibilityItems();
---

<section aria-label="Repere profesionale" class="credibility" style={`--credibility-count: ${items.length}`}>
  {
    items.map((item) => (
      <div class="credibility__cell">
        <div class="credibility__title">{item.title}</div>
        <div class="credibility__text">{item.text}</div>
      </div>
    ))
  }
</section>

<style>
  /*
   * Coloane = numărul de celule (3 sau 4, în funcție de `missingData.yearsOfExperience`),
   * nu auto-fit: cu un rând unic incomplet, track-urile goale rămân sizate de
   * celulele anterioare și lasă să se vadă fundalul containerului — vezi nota
   * din DeCe.astro pentru același bug. Sub 1060px, o singură coloană.
   */
  .credibility {
    display: grid;
    grid-template-columns: repeat(var(--credibility-count, 4), 1fr);
    gap: 1px;
    background: var(--color-hairline);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    overflow: hidden;
    margin-bottom: var(--section-gap);
  }

  @media (max-width: 1059px) {
    .credibility {
      grid-template-columns: 1fr;
    }
  }

  .credibility__cell {
    background: #fff;
    padding: 26px 24px;
  }

  .credibility__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 15.5px;
    color: var(--color-navy);
    margin-bottom: 5px;
  }

  .credibility__text {
    font-size: 14.5px;
    color: var(--color-muted);
    line-height: 1.5;
  }
</style>
