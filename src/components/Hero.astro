---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/adrian-hero.webp';
import { contact, missingData } from '../config/site';
---

<section id="acasa" data-screen-label="Hero" class="hero">
  <div>
    <p class="hero__eyebrow"><span class="hero__eyebrow-dot" aria-hidden="true"></span>SPECIALIST AUTORIZAT ISC · IAȘI</p>
    <h1 class="hero__title">
      Diriginte de șantier în Iași.<br />
      <span class="hero__title-muted">Control tehnic la fiecare etapă a construcției.</span>
    </h1>
    <p class="hero__lead">
      Dirigenție de șantier, <strong>responsabil tehnic cu execuția</strong> și consultanță tehnică pentru beneficiari,
      dezvoltatori și executanți din municipiul și județul Iași.
    </p>
    <div class="hero__actions">
      <a href={contact.phoneHref} class="hero__btn hero__btn--primary">Sună la {contact.phoneDisplay}</a>
      <a href="#contact" class="hero__btn hero__btn--secondary">Trimite detaliile lucrării</a>
    </div>
    <p class="hero__signature">Olari Adrian Ionuț · Dirigenție de șantier · RTE · Consultanță tehnică</p>
  </div>

  <div class="hero__media">
    <div class="hero__image-frame">
      <Image
        src={heroImage}
        alt="Olari Adrian Ionuț, diriginte de șantier autorizat ISC, pe un șantier din Iași"
        widths={[400, 700]}
        sizes="(max-width: 1059px) 100vw, 560px"
        loading="eager"
        fetchpriority="high"
        class="hero__image"
      />
    </div>
    <div class="hero__badge">AUTORIZAT ISC</div>
    <p class="hero__isc-todo">{missingData.iscAuthorizationNumber}</p>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: clamp(28px, 5vw, 60px);
    align-items: center;
    padding: clamp(32px, 6vw, 64px) 0 clamp(48px, 7vw, 80px);
  }

  @media (max-width: 1059px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-tech-blue);
    background: #fff;
    border: 1px solid rgba(23, 25, 29, 0.18);
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    margin: 0 0 24px;
  }

  .hero__eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent-solid);
    flex-shrink: 0;
  }

  .hero__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(34px, 5.2vw, 56px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 20px;
    color: var(--color-navy);
    text-wrap: balance;
  }

  .hero__title-muted {
    color: var(--color-muted);
  }

  .hero__lead {
    font-size: clamp(17px, 1.5vw, 19px);
    line-height: 1.65;
    color: var(--color-anthracite);
    margin: 0 0 30px;
    max-width: 54ch;
    text-wrap: pretty;
  }

  .hero__lead strong {
    color: var(--color-navy);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 26px;
  }

  .hero__btn {
    padding: 17px 30px;
    border-radius: var(--radius-button);
    font-weight: 700;
    font-size: 16.5px;
    flex: 0 0 auto;
    text-align: center;
  }

  @media (max-width: 1059px) {
    .hero__btn {
      flex: 1 1 100%;
    }
  }

  .hero__btn--primary {
    background: var(--color-accent-solid);
    color: var(--color-on-accent-solid);
    box-shadow: var(--shadow-button-accent);
  }

  .hero__btn--primary:hover {
    background: var(--color-accent-solid-hover);
    color: var(--color-on-accent-solid);
  }

  .hero__btn--secondary {
    border: 1.5px solid rgba(23, 25, 29, 0.3);
    background: #fff;
    color: var(--color-navy);
  }

  .hero__btn--secondary:hover {
    border-color: var(--color-navy);
    color: var(--color-navy);
  }

  .hero__signature {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-muted);
    margin: 0;
  }

  .hero__media {
    position: relative;
  }

  .hero__image-frame {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-navy);
    box-shadow: var(--shadow-hero-image);
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__badge {
    position: absolute;
    bottom: -14px;
    left: -14px;
    background: var(--color-navy);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 12px 16px;
    border-radius: var(--radius-input);
    border: 1px solid var(--color-accent-solid);
    box-shadow: var(--shadow-badge);
  }

  .hero__isc-todo {
    position: absolute;
    bottom: -14px;
    right: 0;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-accent-ink);
    background: #fff;
    border: 1px dashed rgba(227, 181, 5, 0.55);
    padding: 6px 10px;
    border-radius: 6px;
  }

  @media (max-width: 1059px) {
    .hero__isc-todo {
      position: static;
      display: inline-block;
      margin-top: 24px;
    }
  }
</style>
