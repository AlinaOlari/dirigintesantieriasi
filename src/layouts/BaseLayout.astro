---
import '../styles/global.css';
import { site, contact } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.titleTag, description = site.description } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, site.url);
const ogImageURL = new URL('/og-image.jpg', site.url);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description:
    'Dirigenție de șantier, responsabil tehnic cu execuția și consultanță tehnică în construcții, în municipiul și județul Iași.',
  url: site.url,
  telephone: contact.phoneE164,
  email: contact.email,
  areaServed: { '@type': 'AdministrativeArea', name: 'Județul Iași, România' },
  address: { '@type': 'PostalAddress', addressLocality: 'Iași', addressCountry: 'RO' },
  knowsAbout: [
    'dirigenție de șantier',
    'responsabil tehnic cu execuția',
    'consultanță tehnică în construcții',
    'recepția lucrărilor',
  ],
};
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:title" content={site.ogTitle} />
    <meta property="og:description" content={site.ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="scroll-sentinel" aria-hidden="true"></div>
    <a href="#main" class="skip-link">Sari la conținut</a>
    <div id="scroll-progress" class="scroll-progress" aria-hidden="true"></div>
    <slot />

    <script>
      const bar = document.getElementById('scroll-progress');
      if (bar) {
        let ticking = false;
        const update = () => {
          const doc = document.documentElement;
          const max = doc.scrollHeight - window.innerHeight;
          const pct = max > 0 ? Math.min(100, (window.scrollY / max) * 100) : 0;
          bar.style.width = pct + '%';
          ticking = false;
        };
        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              requestAnimationFrame(update);
              ticking = true;
            }
          },
          { passive: true },
        );
        update();
      }
    </script>
  </body>
</html>

<style is:global>
  .scroll-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
  }

  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background: var(--color-accent-solid);
    z-index: 300;
    width: 0%;
    transition: width 90ms linear;
  }
</style>
